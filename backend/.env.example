# Config para rodar o backend sozinho (sem Docker), ex.: `npm run dev`
# conectando num Postgres local. Para o deploy completo via `docker compose`,
# use o .env.example da raiz do projeto em vez deste — lá as variáveis são
# geradas automaticamente pelo `make up`.

PORT=3001
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_NAME=sustentabilidade_rural
DB_USER=postgres
DB_PASSWORD=sua_senha_aqui

FRONTEND_URL=http://localhost:5173

# --- Opcionais (têm default de desenvolvimento no código) ---
# JWT_SECRET=troque-por-um-valor-aleatorio-de-32-bytes-em-producao
# JWT_EXPIRES_IN=12h
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=troque-antes-de-ir-para-producao

# DB_PASSWORD e JWT_SECRET também aceitam a variante "_FILE" (ex.:
# DB_PASSWORD_FILE=/run/secrets/db_password), lida no lugar do valor direto
# quando presente — útil pra integrar com Docker/Kubernetes secrets.
