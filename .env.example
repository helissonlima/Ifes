# =============================================================
# SustentaCafé — Exemplo de Configuração
#
# NÃO edite este arquivo para uso. Rode `make up` (ou `npm run env`)
# e o arquivo `.env` será criado automaticamente, já com TODAS as
# senhas/segredos gerados aleatoriamente no primeiro deploy.
#
# Para gerar um segredo manualmente:
#   openssl rand -hex 16   # senhas (32 caracteres)
#   openssl rand -hex 32   # segredos JWT (64 caracteres)
# =============================================================

# --- Aplicação ---
APP_PORT=5173
NODE_ENV=production
FRONTEND_URL=http://localhost:5173

# --- Banco de Dados ---
DB_NAME=sustentabilidade_rural
DB_USER=postgres
DB_PASSWORD=__gerado_automaticamente_no_make_up__

# --- Segredo JWT (32 bytes / 64 caracteres) ---
JWT_SECRET=__gerado_automaticamente_no_make_up__

# --- Usuário Admin inicial (criado no primeiro boot do backend) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=__gerado_automaticamente_no_make_up__

# --- Opcionais (têm default no código, só declare se quiser mudar) ---
# Validade do token de sessão (formato aceito pela lib "ms": 12h, 30m, 7d...)
# JWT_EXPIRES_IN=12h
# URL da API que o frontend chama, embutida no build. O nginx.conf deste
# projeto já faz proxy de /api para o backend — só mude se o frontend for
# servido atrás de outro proxy/domínio.
# VITE_API_URL=/api
