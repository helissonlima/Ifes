# =============================================================
# SustentaCafé — Exemplo de Configuração
#
# NÃO edite este arquivo para uso. Rode `make up` (ou `npm run env`)
# e o arquivo `.env` será criado automaticamente, já com TODAS as
# senhas geradas aleatoriamente com 32 caracteres no primeiro deploy.
#
# Para gerar um segredo manualmente (32 caracteres hex):
#   openssl rand -hex 16
#   node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
# =============================================================

# --- Aplicação ---
APP_PORT=5173
NODE_ENV=production
FRONTEND_URL=http://localhost:5173

# --- Banco de Dados ---
DB_NAME=sustentabilidade_rural
DB_USER=postgres
DB_PASSWORD=__gerado_automaticamente_no_make_up__

# --- Segredos JWT (32 caracteres cada) ---
JWT_SECRET=__gerado_automaticamente_no_make_up__
JWT_REFRESH_SECRET=__gerado_automaticamente_no_make_up__

# --- Usuário Admin inicial (criado no primeiro boot do backend) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=__gerado_automaticamente_no_make_up__
