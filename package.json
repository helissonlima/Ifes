{
  "name": "ifes-workspace",
  "private": true,
  "scripts": {
    "env": "node scripts/init-env.js",
    "up": "node scripts/init-env.js && docker compose up -d --build",
    "dev": "npm --prefix frontend run dev --",
    "build": "npm --prefix frontend run build",
    "lint": "npm --prefix frontend run lint",
    "dev:frontend": "npm --prefix frontend run dev --",
    "build:frontend": "npm --prefix frontend run build",
    "dev:backend": "npm --prefix backend run dev",
    "start:backend": "npm --prefix backend run start",
    "check:forbidden": "bash ./scripts/check-forbidden-terms.sh",
    "test:backend": "npm --prefix backend run test",
    "test:frontend": "npm --prefix frontend run test",
    "test": "npm run test:backend && npm run test:frontend",
    "verify": "npm run check:forbidden && npm run build",
    "verify:strict": "npm run check:forbidden && npm run lint && npm run build && npm run test"
  }
}
